cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.VolsurfaceForecastEnv/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Raw proprietary data
data/raw/

# Generated / temporary model files
*.pt
*.pth
*.ckpt

# Temporary files
*.tmp
*.log
EOF

data/treated/
